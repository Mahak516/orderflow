# Copy to .env for local development. Never commit the real .env file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/orderflow
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Optional: turns on the AI shopping assistant. Leave both empty to keep it switched off.
# FREE option: create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Paid option: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ASSISTANT_PROVIDER=gemini
# ASSISTANT_MODEL=gemini-2.5-flash
